{
  "extends": "@lichtblick/tsconfig/base",
  "include": ["./**/*", "../common/**/*", "../../package.json"],
  "compilerOptions": {
    "rootDir": "../../",
    "noEmit": true,
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "useUnknownInCatchVariables": false,
    "types": ["node", "jest"],
    "lib": ["dom", "dom.iterable", "es2022", "webworker"],
    "paths": {
      "@lichtblick/suite-base/*": ["../../../suite-base/src/*"],
      // Mirrors the webpack alias in packages/suite-base/webpack.ts (makeConfig): proprietary
      // layouts (git submodule) when present, else a stub.
      "@lichtblick/private-layouts": [
        "../../../suite-base/src/layouts/private/index.ts",
        "../../../suite-base/src/layouts/noPrivateLayouts.ts"
      ]
    }
  }
}
