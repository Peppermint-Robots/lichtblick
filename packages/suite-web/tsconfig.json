{
  "extends": "@lichtblick/tsconfig/base",
  "include": ["**/*"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "es2022", "webworker", "ESNext.Disposable"],
    "noEmit": true,
    "experimentalDecorators": true,
    "useUnknownInCatchVariables": false,
    "types": ["node", "jest"],
    "paths": {
      "@lichtblick/suite-base/*": ["../suite-base/src/*"],
      // Proprietary layouts (git submodule at src/layouts/private/) when present, else a stub.
      // Mirrors the webpack alias in src/webpackConfigs.ts. TypeScript picks the first match that
      // exists on disk, so open-source checkouts type-check against the stub.
      "@lichtblick/private-layouts": ["./src/layouts/private/index.ts", "./src/layouts/noPrivateLayouts.ts"]
    }
  }
}
