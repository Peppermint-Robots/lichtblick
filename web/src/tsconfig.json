{
  "extends": "@lichtblick/tsconfig/base",
  "include": ["./**/*"],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "es2022", "webworker", "ESNext.Disposable"],
    "experimentalDecorators": true,
    "useUnknownInCatchVariables": false,
    "paths": {
      "@lichtblick/suite-base/*": ["../../packages/suite-base/src/*"],
      // Mirrors the webpack alias in packages/suite-base/webpack.ts (makeConfig): proprietary
      // layouts (git submodule at packages/suite-base/src/layouts/private/) when present,
      // otherwise a stub that contributes none.
      "@lichtblick/private-layouts": [
        "../../packages/suite-base/src/layouts/private/index.ts",
        "../../packages/suite-base/src/layouts/noPrivateLayouts.ts"
      ]
    }
  }
}
